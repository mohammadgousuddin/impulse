rules_version = '2';

// Impulse - The Bridge : Cloud Firestore security rules
// Any visitor may submit a reading, but only a well-shaped one — this
// closes an open write: without it, any client on the internet (not
// just this app) could write arbitrary documents into the collection.
// Only the signed-in admin may read the archive. Nobody may edit or
// delete a reading.
// Deployed to project: impulse-e6a58

service cloud.firestore {
  match /databases/{database}/documents {
    match /readings/{docId} {
      allow create: if docId.matches('^r[0-9a-z]{1,40}$')
                    && request.resource.data.keys().hasOnly(['json','ts'])
                    && request.resource.data.json is string
                    && request.resource.data.json.size() < 20000
                    && request.resource.data.ts is string
                    && request.resource.data.ts.size() < 40;
      allow read: if request.auth != null && request.auth.uid == 'WyFgaQf3XKe7nmTTs4K2IIuLTm12';
      allow update, delete: if false;
      }
    }
  }
